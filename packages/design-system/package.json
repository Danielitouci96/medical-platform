{
  "name": "@medical/design-system",
  "version": "1.0.0",
  "description": "Design System profesional, reutilizable, versionable y desacoplado para la plataforma médica. Independiente del dominio médico.",
  "private": true,
  "type": "module",
  "main": "./dist/index.es.js",
  "style": "./dist/design-system.css",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.es.js"
    },
    "./styles.css": "./dist/design-system.css",
    "./themes/*": "./themes/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src",
    "themes",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "lint": "eslint src",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 4400",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@radix-ui/react-visually-hidden": "^1.1.0",
    "classnames": "^2.5.0",
    "lucide-react": "^1.43.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.3.0",
    "@storybook/addon-actions": "^8.3.0",
    "@storybook/addon-controls": "^8.3.0",
    "@storybook/addon-docs": "^8.3.0",
    "@storybook/addon-themes": "^8.3.0",
    "@storybook/addon-viewport": "^8.3.0",
    "@storybook/react": "^8.3.0",
    "@storybook/react-vite": "^8.3.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "react-test-renderer": "^19.0.0",
    "sass": "^1.79.0",
    "storybook": "^8.3.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
